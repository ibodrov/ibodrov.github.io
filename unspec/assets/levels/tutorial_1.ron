            position: (-100.0, 200.0),
        ),
        // Fixed platform that catches the ball
        Platform(
            position: (-100.0, 50.0),
            rotation: 0.2,
            width: 120.0,
        ),
    ],
    inventory: {
        Platform: Some(1),
    },
)
